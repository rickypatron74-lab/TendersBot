# WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token que tú inventas y pegas también en la config del webhook en Meta
WHATSAPP_VERIFY_TOKEN=

# Numeros de WhatsApp que pueden dar comandos de admin (CONFIRMAR, LISTO, ENTREGADO)
# Formato E.164 sin '+', separados por coma. Ej: 573001234567,573007654321
ADMIN_PHONE_NUMBERS=

# Numero de WhatsApp de la cocina donde llegan las comandas
KITCHEN_PHONE_NUMBER=

DATABASE_URL="postgresql://user:password@localhost:5432/tendersbot"

# URL publica de la imagen del QR para cobrar (Nequi/Daviplata/Bancolombia)
PAYMENT_QR_IMAGE_URL=
# Texto con los datos de cuenta para transferencia
BANK_ACCOUNT_INFO="Nequi 300 000 0000 a nombre de ..."

PORT=3000
